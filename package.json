{
  "name": "spark-chamber",
  "productName": "spark",
  "version": "0.2.0",
  "description": "The Electron test runner",
  "main": "lib/main.js",
  "exports": {
    ".": "./lib/spark.js",
    "./config": "./lib/config.js",
    "./init": "./lib/init.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "type": "module",
  "bin": {
    "spark": "./bin/spark.cjs"
  },
  "scripts": {
    "lint": "eslint",
    "test": "npm run test:spark && npm run test:node",
    "test:spark": "electron . --no-sandbox test/main/**/*.test.js -r test/renderer/**/*.test.js",
    "test:node": "node --test test/node/**/*.test.js",
    "coverage": "c8 -o coverage --reporter=text --reporter=lcov --include='lib/**' --include='bin/**' npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inukshuk/spark.git"
  },
  "keywords": [
    "electron",
    "test",
    "testing",
    "coverage"
  ],
  "author": "Sylvester Keil <sylvester@keil.or.at>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/inukshuk/spark/issues"
  },
  "homepage": "https://github.com/inukshuk/spark#readme",
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "electron": ">=40"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "electron": "^44.5.1",
    "eslint": "^10.12.0",
    "neostandard": "^0.14.0-next.1"
  },
  "allowScripts": {
    "electron@41.10.7": true
  }
}
